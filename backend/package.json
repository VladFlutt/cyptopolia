    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.0",
    "fastify": "^5.2.1",
    "viem": "^2.23.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
